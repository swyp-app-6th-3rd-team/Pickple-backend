{
  "description": "Pickple repository hooks",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git -c 'safe.directory=*' rev-parse --show-toplevel)/.codex/hooks/session-start.sh\"",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"& { $repoRoot = (& git -c 'safe.directory=*' rev-parse --show-toplevel).Trim(); & (Join-Path $repoRoot '.codex/hooks/session-start.ps1') }\"",
            "statusMessage": "Loading Pickple repository context",
            "additionalContextLimit": 1200,
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git -c 'safe.directory=*' rev-parse --show-toplevel)/.codex/hooks/stop-validation.sh\"",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"& { $repoRoot = (& git -c 'safe.directory=*' rev-parse --show-toplevel).Trim(); & (Join-Path $repoRoot '.codex/hooks/stop-validation.ps1') }\"",
            "statusMessage": "Validating the local Codex harness",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
