<?xml version="1.0" encoding="UTF-8"?>
<!--
  로그를 레벨 구분 없이 한 파일에 시간순으로 남긴다.

      ${LOG_DIR}/app.log              현재 파일
      ${LOG_DIR}/app-2026-08-15.0.log 롤링된 파일

  레벨로 파일을 나누지 않는 이유: 아래 FILE_LOG_PATTERN 이 각 줄에 시각과 레벨을
  찍으므로 `grep ERROR` 로 걸러낼 수 있고, 한 요청의 흐름을 볼 때 파일을 오갈 필요가 없다.
  예전에는 error/ warn/ info/ 로 나눴으나, info 가 ThresholdFilter 로 INFO 이상을
  전부 담아 ERROR 한 줄이 두 파일에 중복 저장됐다.
  근거: docs/adr/0025-single-log-file.md (ADR-0009 의 레벨 분리를 대체)

  이 디렉터리를 도커 볼륨에 마운트해 컨테이너가 삭제돼도 로그가 남게 한다.
  근거: docs/adr/0009-log-persistence.md

  파일명이 logback.xml 이 아니라 logback-spring.xml 인 이유는
  스프링이 로그 초기화를 제어할 수 있어야 <springProfile> 이 동작하기 때문이다.
-->
<configuration>

    <!-- 스프링 부트의 기본 변환 규칙(CONSOLE_LOG_PATTERN, 색상 등)을 가져온다. -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!--
      로그 위치. 컨테이너에서는 환경변수 LOG_DIR 로 덮어쓴다(/app/logs).
      로컬 개발에서는 프로젝트 아래 logs/ 에 쌓인다(.gitignore 대상).
    -->
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="app"/>
    <property name="LOG_DIR" value="${LOG_DIR:-logs}"/>

    <!--
      correlationId 는 CorrelationIdFilter 가 MDC 에 넣는다(X-Request-Id 헤더 또는 UUID).
      이게 있어야 한 요청의 로그를 흩어진 줄들 사이에서 다시 모을 수 있다.
      값이 없는 로그(기동 로그 등)는 하이픈으로 표시된다.
    -->
    <!--
      trace_id / span_id 는 OTel 에이전트가 MDC 에 넣는다(logback-mdc 계측).
      에이전트 없이 실행하면 값이 없으므로 하이픈으로 표시된다 — 즉 이 패턴은
      에이전트 유무와 무관하게 안전하다.

      두 추적 ID 가 공존하는 이유:
        correlationId — 이 앱이 만든다(X-Request-Id). 클라이언트가 지정할 수 있다.
        trace_id      — OTel 이 만든다. 서비스 경계를 넘어 전파된다.
      Grafana 에서 트레이스를 찾은 뒤 그 trace_id 로 로그를 조회하면
      두 세계가 연결된다(Loki datasource 의 derivedFields 가 이 값을 파싱한다).
    -->
    <property name="FILE_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{correlationId:--}] [%X{trace_id:--}] [%X{span_id:--}] [%thread] %logger{36} - %msg%n%wEx"/>

    <property name="CONSOLE_LOG_PATTERN_WITH_CID"
              value="%clr(%d{HH:mm:ss.SSS}){faint} %clr(%-5level) %clr([%X{correlationId:--}]){magenta} %clr([%X{trace_id:--}]){blue} %clr(%logger{36}){cyan} - %msg%n%wEx"/>

    <!-- 롤링 정책: 하루 단위 + 파일당 100MB, 30일 보관, 전체 3GB 상한 -->
    <property name="MAX_HISTORY" value="${LOG_MAX_HISTORY:-30}"/>
    <property name="MAX_FILE_SIZE" value="${LOG_MAX_FILE_SIZE:-100MB}"/>
    <property name="TOTAL_SIZE_CAP" value="${LOG_TOTAL_SIZE_CAP:-3GB}"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN_WITH_CID}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!--
      파일 appender 하나로 전부 받는다.
      레벨 필터를 두지 않으므로 root level 이 무엇을 남길지 정하는 유일한 기준이다.
    -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/app-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!--
      파일 쓰기를 비동기로 돌린다. 디스크가 느려도 요청 스레드가 붙잡히지 않는다.
      queueSize 를 넘으면 기본 동작은 WARN 이하를 버리는 것이므로
      discardingThreshold=0 으로 아무것도 버리지 않게 한다 — 장애 조사용 로그를
      정작 장애 때 잃으면 의미가 없다.

      includeCallerData 는 ERROR 스택의 호출 위치를 남기기 위해 켠다.
      예전에는 ERROR appender 에만 켰는데, 이제 이 appender 가 ERROR 도 담는다.
    -->
    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="FILE"/>
        <queueSize>1024</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>true</includeCallerData>
    </appender>

    <!--
      test 프로파일: 콘솔만. 테스트가 파일을 만들면 빌드 디렉터리가 지저분해지고
      TestContainers 기동마다 롤링이 돈다.
    -->
    <springProfile name="test">
        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- local: 콘솔 + 파일. 로컬에서도 파일 로깅이 도는지 확인할 수 있어야 한다. -->
    <springProfile name="local">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_FILE"/>
        </root>
        <logger name="app.pickple" level="DEBUG"/>
    </springProfile>

    <!--
      prod: 콘솔도 유지한다. 파일만 남기고 콘솔을 끄면 `docker logs` 가 비어
      컨테이너가 기동조차 못 했을 때 원인을 볼 수 없다.
      기동 실패는 파일 appender 가 준비되기 전에 일어날 수 있다.
    -->
    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_FILE"/>
        </root>
    </springProfile>

    <!-- 프로파일 미지정 -->
    <springProfile name="!test &amp; !local &amp; !prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_FILE"/>
        </root>
    </springProfile>

</configuration>
