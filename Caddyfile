# 리버스 프록시 (ADR-0022).
#
# 앱의 8080 을 인터넷에 직접 노출하지 않는 이유는 두 가지다.
#   1. 보안 그룹에 8080 규칙을 만들 필요가 없다(compose 내부 네트워크로만 접근).
#   2. 도메인 사이트 블록이면 Let's Encrypt 인증서가 자동 발급·갱신되고 80 은 443 으로
#      리다이렉트된다. ALB(월 $22)도 ACM 도 필요 없다.
#
# SITE_ADDRESS 는 compose environment 로 들어온다.
#   EC2  : dev-api.pickple.app  → 자동 HTTPS
#   로컬 : :80                  → HTTP 만 (docker-compose-dev/prod 는 이 파일을 쓰지 않는다)
#
# ⚠️ 도메인 블록은 기동 즉시 ACME HTTP-01 을 시도한다. DNS 가 EIP 를 가리키기 전에 띄우면
#    실패 검증이 Let's Encrypt 한도(같은 호스트 주 5회)를 태운다. terraform/README.md 순서를 지킨다.

# ACME 연락처(email)는 두지 않는다. Caddy 가 만료 전에 스스로 갱신하고, PUBLIC 저장소에
# 개인 메일을 적지 않기 위해서다. 필요해지면 전역 블록 `{ email ... }` 을 .env 값으로 넣는다.

# ── 공통 라우팅 ───────────────────────────────────────────────
#
# application.yml 은 관리 엔드포인트를 서비스 포트와 분리해 9090 에 둔다.
# actuator 는 JVM·DB 내부 상태를 드러내므로 외부에 여는 것은 /actuator/health 하나뿐이다.
# 나머지 actuator 는 SSM 포트 포워딩으로 9090 에 직접 붙는다:
#   aws ssm start-session --target <id> \
#     --document-name AWS-StartPortForwardingSession \
#     --parameters '{"portNumber":["9090"],"localPortNumber":["9090"]}'
(routes) {
	encode gzip

	handle /actuator/health {
		reverse_proxy app:9090
	}

	handle /actuator/* {
		respond "Not Found" 404
	}

	handle {
		reverse_proxy app:8080 {
			header_up X-Real-IP {remote_host}
			# 앱 기동 중(start_period 90s)에는 502 대신 잠시 기다린다.
			lb_try_duration 5s
		}
	}
}

# ── 공개 사이트 ───────────────────────────────────────────────
{$SITE_ADDRESS} {
	import routes

	log {
		output stdout
		format console
	}
}

# ── localhost ─────────────────────────────────────────────────
#
# deploy-develop.yml 의 헬스체크가 EC2 안에서 `curl http://localhost/actuator/health` 를 친다.
# 도메인 블록만 있으면 localhost 요청은 어느 사이트에도 매칭되지 않아 배포마다 헬스 스텝이
# 실패한다. 헬스 경로 하나만 열어 둔다. 인터넷에서는 Host 헤더가 다르므로 닿지 않는다.
http://localhost {
	handle /actuator/health {
		reverse_proxy app:9090
	}

	handle {
		respond "Not Found" 404
	}
}
