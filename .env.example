# 이 파일을 .env 로 복사한 뒤 값을 채운다.
#   cp .env.example .env
# .env 는 .gitignore 에 있다. 절대 커밋하지 않는다.

# ── 컨테이너 ────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=pickple
TZ=Asia/Seoul

# ── MySQL ──────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=pickple
MYSQL_USER=pickple
MYSQL_PASSWORD=change-me-app
MYSQL_PORT=13307

# ── 애플리케이션 ────────────────────────────────────────────
APP_PORT=8081
# local  = SQL 로그 + 콘솔·파일 로깅
# prod   = 마이그레이션만 + 콘솔·파일 로깅
SPRING_PROFILES_ACTIVE=local

# ── 로그 ────────────────────────────────────────────────────
# 로그는 error/warn/info 디렉터리로 나뉘어 도커 볼륨(pickple-log)에 쌓인다.
# 컨테이너를 삭제해도 남는다. 확인 방법은 README 의 "로그 확인" 참조.
LOG_MAX_HISTORY=30
LOG_TOTAL_SIZE_CAP=3GB

# ── JWT ────────────────────────────────────────────────────
# HS256 이므로 최소 256비트(32바이트) 이상이어야 한다.
# 기동 시 길이를 검증하며, 짧으면 애플리케이션이 뜨지 않는다.
# 생성: openssl rand -base64 48
JWT_SECRET_KEY=

# ── OAuth2 ─────────────────────────────────────────────────
# 쓰지 않는 프로바이더는 줄을 주석 처리한다(빈 값 금지).
#   application.yml 의 :not-configured 기본값은 변수가 "미정의"일 때만 적용된다.
#   OAUTH_GOOGLE_CLIENT_ID= 처럼 빈 값을 두면 기본값이 무시되어 기동이 실패한다.
# Google:  https://console.cloud.google.com/apis/credentials
#OAUTH_GOOGLE_CLIENT_ID=
#OAUTH_GOOGLE_CLIENT_SECRET=
# Kakao:   https://developers.kakao.com/console/app
#OAUTH_KAKAO_CLIENT_ID=
#OAUTH_KAKAO_CLIENT_SECRET=
# Naver:   https://developers.naver.com/apps
#OAUTH_NAVER_CLIENT_ID=
#OAUTH_NAVER_CLIENT_SECRET=
# Apple native: 키를 받기 전에는 false로 둔다.
OAUTH_APPLE_ENABLED=false
#OAUTH_APPLE_TEAM_ID=
#OAUTH_APPLE_KEY_ID=
# iOS Bundle ID (Services ID가 아님)
#OAUTH_APPLE_CLIENT_ID=
# .p8 파일 전체를 한 줄 Base64로 변환한 값. .p8 원문은 넣거나 커밋하지 않는다.
# PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes('AuthKey_XXXX.p8'))
#OAUTH_APPLE_PRIVATE_KEY_BASE64=
# Apple에서 받는 값이 아니다. 별도로 생성한 32바이트 AES 키의 Base64 값.
# .p8 또는 JWT_SECRET_KEY를 재사용하지 않는다.
# keyring 형식. 키 교체 중에는 이전 키도 함께 유지한다: k2=NEW_BASE64,k1=OLD_BASE64
#OAUTH_APPLE_TOKEN_ENCRYPTION_KEYS=k1=BASE64_32_BYTE_KEY
#OAUTH_APPLE_TOKEN_ACTIVE_KEY_ID=k1

# ── 관리 포트 ──────────────────────────────────────────────
# actuator 는 서비스 포트(8080)가 아니라 이 포트에 열린다.
# 컨테이너 밖으로 매핑하지 않으므로 내부 지표가 외부에 공개되지 않는다.
# EC2 에서는 SSM 포트 포워딩으로 붙는다(terraform/README.md 참조).
MANAGEMENT_PORT=9090
