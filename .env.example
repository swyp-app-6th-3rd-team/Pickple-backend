# 이 파일을 .env 로 복사한 뒤 값을 채운다.
#   cp .env.example .env
# .env 는 .gitignore 에 있다. 절대 커밋하지 않는다.
#
# 이 파일은 두 곳에서 읽힌다.
#   1. Docker Compose 의 변수 보간 (MYSQL_*, COMPOSE_PROJECT_NAME 등)
#   2. Spring 의 프로퍼티 소스 — application-local.yml 의 spring.config.import
#      덕분에 IntelliJ 실행과 `./gradlew bootRun` 에서도 값이 주입된다(ADR-0024).
# 따라서 값에 따옴표나 후행 공백을 넣지 않는다. 두 파서의 해석이 갈릴 수 있다.
#
# ── @secret 마커 (ADR-0026) ─────────────────────────────────
# 이 파일은 Secrets Manager 키 스키마의 **정본**이기도 하다.
# terraform/locals.tf 와 terraform/scripts/sync-secrets.sh 가 이 파일을 파싱한다.
# 키를 추가할 때 다른 곳에 목록을 또 적지 않는다 — 여기만 고치면 된다.
#
# 키 선언 "직전의 연속 주석 블록"에 마커를 둔다. 빈 줄이 블록을 끊는다.
#   @secret          Secrets Manager 에 올린다. 없으면 로컬 전용이라 올라가지 않는다
#   @generate=N      값이 없을 때 openssl rand -base64 N 으로 생성한다
#   @remote-wins     원격 값이 있으면 로컬 .env 보다 우선한다(초기화된 MySQL 보호)
#   @default=V       최종 폴백. 기본은 not-configured
#
# 마커는 값 줄이 아니라 주석 줄에 둔다 — 인라인으로 쓰면 cp 후 값에 딸려 들어간다.
# SPRING_PROFILES_ACTIVE 처럼 마커가 없는 키는 절대 올라가지 않는다(운영 프로파일 오염 방지).

# ── 컨테이너 ────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=pickple
TZ=Asia/Seoul

# ── MySQL ──────────────────────────────────────────────────
# @secret @remote-wins @generate=24
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=pickple
MYSQL_USER=pickple
# @secret @remote-wins @generate=24
MYSQL_PASSWORD=change-me-app
MYSQL_PORT=13307

# ── 애플리케이션 ────────────────────────────────────────────
APP_PORT=8081
# local  = SQL 로그 + 콘솔·파일 로깅
# prod   = 마이그레이션만 + 콘솔·파일 로깅
SPRING_PROFILES_ACTIVE=local

# ── 로그 ────────────────────────────────────────────────────
# 로그는 error/warn/info 디렉터리로 나뉘어 도커 볼륨(pickple-log)에 쌓인다.
# 컨테이너를 삭제해도 남는다. 확인 방법은 README 의 "로그 확인" 참조.
LOG_MAX_HISTORY=30
LOG_TOTAL_SIZE_CAP=3GB

# ── JWT ────────────────────────────────────────────────────
# HS256 이므로 최소 256비트(32바이트) 이상이어야 한다.
# 기동 시 길이를 검증하며, 짧으면 애플리케이션이 뜨지 않는다.
# 값이 비어 있어도 같은 메시지로 실패한다 — "길이 부족"과 "미주입"이 한 메시지다.
# 생성: openssl rand -base64 48
# @secret @generate=48
JWT_SECRET_KEY=

# ── OAuth2 ─────────────────────────────────────────────────
# 쓰지 않는 프로바이더는 줄을 주석 처리한다(빈 값 금지).
#   application.yml 의 :not-configured 기본값은 변수가 "미정의"일 때만 적용된다.
#   OAUTH_GOOGLE_CLIENT_ID= 처럼 빈 값을 두면 기본값이 무시되어 기동이 실패한다.
# Google:  https://console.cloud.google.com/apis/credentials
# @secret
#OAUTH_GOOGLE_CLIENT_ID=
# @secret
#OAUTH_GOOGLE_CLIENT_SECRET=
# Kakao:   https://developers.kakao.com/console/app
# @secret
#OAUTH_KAKAO_CLIENT_ID=
# @secret
#OAUTH_KAKAO_CLIENT_SECRET=
# Naver:   https://developers.naver.com/apps
# @secret
#OAUTH_NAVER_CLIENT_ID=
# @secret
#OAUTH_NAVER_CLIENT_SECRET=
# Apple native: 키를 받기 전에는 false로 둔다.
# true 로 두면 아래 6개(TEAM_ID·KEY_ID·CLIENT_ID·PRIVATE_KEY_BASE64·
# TOKEN_ENCRYPTION_KEYS·TOKEN_ACTIVE_KEY_ID)가 전부 필수가 되고,
# 하나라도 비거나 not-configured 면 기동이 실패한다. Apple 을 안 쓰면 false 로 둔다.
# @secret @default=false
OAUTH_APPLE_ENABLED=false
# @secret
#OAUTH_APPLE_TEAM_ID=
# @secret
#OAUTH_APPLE_KEY_ID=
# iOS Bundle ID (Services ID가 아님)
# @secret
#OAUTH_APPLE_CLIENT_ID=
# .p8 파일 전체를 한 줄 Base64로 변환한 값. .p8 원문은 넣거나 커밋하지 않는다.
# PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes('AuthKey_XXXX.p8'))
# @secret
#OAUTH_APPLE_PRIVATE_KEY_BASE64=
# Apple에서 받는 값이 아니다. 별도로 생성한 32바이트 AES 키의 Base64 값.
# .p8 또는 JWT_SECRET_KEY를 재사용하지 않는다.
# keyring 형식. 키 교체 중에는 이전 키도 함께 유지한다: k2=NEW_BASE64,k1=OLD_BASE64
# @secret
#OAUTH_APPLE_TOKEN_ENCRYPTION_KEYS=k1=BASE64_32_BYTE_KEY
# @secret
#OAUTH_APPLE_TOKEN_ACTIVE_KEY_ID=k1

# ── 관리 포트 ──────────────────────────────────────────────
# actuator 는 서비스 포트(8080)가 아니라 이 포트에 열린다.
# 컨테이너 밖으로 매핑하지 않으므로 내부 지표가 외부에 공개되지 않는다.
# EC2 에서는 SSM 포트 포워딩으로 붙는다(terraform/README.md 참조).
MANAGEMENT_PORT=9090

# ── 이미지 업로드 S3 (ADR-0021, ADR-0027) ──────────────────
# 이 블록의 키는 비밀 마커를 달지 않는다.
#
# 마커를 달면 terraform/locals.tf 의 secret_keys 가 커지고, 그 목록이 user_data 에
# 박혀 fetch-secrets.sh 의 누락 검사 기준이 된다. 그러면 누군가 sync-secrets.sh 를
# 돌리기 전까지 EC2 가 FATAL 로 기동을 거부한다.
# 버킷 이름·리전·CDN 도메인은 비밀이 아니므로 그 대가를 치를 이유가 없다.
#
# 배포 값의 정본은 Terraform 이고, fetch-secrets.sh 가 SITE_ADDRESS·CORS_ALLOWED_ORIGINS
# 와 같은 "비밀 아닌 배포 파라미터" 블록에서 .env 로 써 넣는다.
#
# 자격증명은 어디에도 적지 않는다. EC2 에서는 인스턴스 프로파일을 AWS SDK 가
# IMDS 로 가져간다(ADR-0013). AWS_ACCESS_KEY_ID 류를 넣으면 그 체인이 죽는다.
#
# ⚠️ 위 문단에서 마커 이름을 그대로 쓰지 않는 이유: locals.tf 의 정규식은 키 선언
# 직전의 "연속된 주석 블록"을 훑기 때문에, 설명문에 마커를 적기만 해도 그 키가
# 비밀로 잡힌다. 빈 줄이 블록을 끊지만 여기서는 아예 단어를 피한다.

FILE_S3_BUCKET=not-configured

# 로컬 LocalStack 전용. 실제 S3 를 쓸 때는 반드시 빈 값이어야 한다 —
# 값이 있으면 endpointOverride 와 path-style 이 켜져 AWS 로 나가지 못한다.
FILE_S3_ENDPOINT=

# CloudFront 배포 도메인(terraform output images_cdn_domain).
# 비어 있으면 SDK 가 S3 객체 URL 을 만든다. 버킷이 비공개라 그 URL 은 403 이 되므로
# 배포 환경에서는 반드시 채운다.
FILE_PUBLIC_BASE_URL=


# 버킷 리전과 어긋나면 PermanentRedirect 가 난다. Terraform 의 var.region 이 정본이다.
AWS_REGION=ap-northeast-2
