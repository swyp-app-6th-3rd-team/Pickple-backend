# 이 파일을 terraform.tfvars 로 복사해 값을 채운다.
#   cp terraform.tfvars.example terraform.tfvars
# terraform.tfvars 는 .gitignore 에 있다 — 커밋하지 않는다.
#
# 전부 기본값이 있으므로, 기본 구성 그대로 쓸 거면 terraform.tfvars 없이도 apply 된다.

# ── 계정·리전 ───────────────────────────────────────────────
# aws_account_id = "251128835262"
# aws_profile    = "root_habin"
# region         = "ap-northeast-2"

# ── 인스턴스 ────────────────────────────────────────────────
# 메모리가 부족하면(docker stats 로 확인) t4g.medium 으로 올린다.
# instance_type         = "t4g.small"
# instance_architecture = "arm64"

# x86 으로 갈 경우 둘을 함께 바꾼다:
# instance_type         = "t3.small"
# instance_architecture = "x86_64"

# ── 배포 ────────────────────────────────────────────────────
# github_repository    = "swyp-app-6th-3rd-team/Pickple-backend"
# github_deploy_branch = "develop"

# OIDC sub 는 immutable 형식으로 자동 생성된다 (locals.tf). 저장소를 옮기면 ID 둘을 바꾼다.
#   gh api repos/<owner>/<repo> --jq '.owner.id, .id'
# github_owner_id      = "317244014"
# github_repository_id = "1339691515"
#
# GitHub 이 형식을 또 바꾸면 CloudTrail 의 AssumeRoleWithWebIdentity AccessDenied 이벤트에
# 찍힌 실제 sub 를 그대로 넣는다(워크플로 로그에는 안 나온다).
# github_oidc_subject = "repo:swyp-app-6th-3rd-team@317244014/Pickple-backend@1339691515:ref:refs/heads/develop"

# ── 외부 접근 (ADR-0023) ────────────────────────────────────
# 아래 *_allowed_cidr 는 기본 null 이며, null 이면 보안그룹 규칙 자체가 생기지 않는다.
# 닫으려면 값을 지우고 apply 하면 된다(인스턴스 replace 없음).
#
# SSH — ssh_public_key 는 필수다(개인키는 절대 넣지 않는다).
#   공개키 얻기: ssh-keygen -y -f ~/.ssh/pickple-dev.pem
# ssh_public_key   = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA..."
# ssh_allowed_cidr = "0.0.0.0/0"       # 자기 IP 로 좁히려면 "203.0.113.10/32"
# ssh_port         = 124               # 22 에서 바꾸면 user_data 가 SELinux·sshd_config 를 함께 고친다
#
# MySQL — ⚠️ 열면 DB 가 인터넷에 노출된다. 방어선은 계정 비밀번호뿐이다.
#   remote root 를 막고 앱 계정(pickple)으로만 붙는다.
#   docker-compose-ec2.yml 의 ports 값과 mysql_host_port 가 같아야 한다.
# mysql_allowed_cidr = "0.0.0.0/0"     # 자기 IP 로 좁히려면 "203.0.113.10/32"
# mysql_host_port    = 13307

# ── 도메인 ───────────────────────────────────────
# domain_name   = "pickple.app"
# api_subdomain = "dev-api"          # → dev-api.pickple.app
#
# 프론트 레코드. NS 가 Route53 으로 넘어오면 apex·www 도 여기서 받는다.
# extra_records = {
#   "@"   = { type = "A",     ttl = 300, records = ["76.76.21.21"] }
#   "www" = { type = "CNAME", ttl = 300, records = ["cname.vercel-dns.com"] }
# }

# ── 런타임 설정 (비밀 아님, ADR-0026) ───────────────────────
#
# 아래 값들은 fetch-secrets.sh 가 EC2 의 .env 에 직접 쓴다.
# 기본값이 variables.tf 에 있으므로 바꿀 때만 적는다.
#
# 로그 보관 정책. 기본 30일 / 3GB.
# log_max_history    = 30
# log_total_size_cap = "3GB"
#
# ⚠️ 프론트 배포 전까지는 아래 3개가 localhost 기본값이다.
#    프론트 도메인이 정해지면 반드시 실제 값으로 바꾼다 —
#    그전까지 OAuth 콜백과 CORS 가 로컬 주소를 가리킨다.
#    allowed_redirect_hosts 는 오픈 리다이렉트 방어선이므로 필요한 호스트만 적는다.
# auth_redirect_uri           = "https://pickple.app/oauth/callback"
# auth_allowed_redirect_hosts = "pickple.app"
# cors_allowed_origins        = "https://pickple.app"
