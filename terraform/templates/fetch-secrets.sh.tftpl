#!/bin/bash
# Secrets Manager 의 JSON 을 docker compose 가 읽을 .env 로 펼친다.
#
# systemd 의 ExecStartPre 가 매 기동마다 호출하므로,
# 비밀을 바꾼 뒤 `systemctl restart buyorpass` 만 하면 반영된다.
#
# 앱은 이 구조를 모른다. application.yml 은 $${SPRING_DATASOURCE_PASSWORD} 같은
# 플레이스홀더만 알고 있어 로컬과 동일하게 동작한다(ADR-0013).
set -euo pipefail

SECRET_ID="${secret_arn}"
REGION="${region}"
ENV_FILE="${app_dir}/.env"

SECRET_JSON="$(aws secretsmanager get-secret-value \
  --secret-id "$SECRET_ID" \
  --region "$REGION" \
  --query SecretString \
  --output text)"

# 값이 자리표시자 그대로면 앱이 뜬 뒤 인증에서 실패한다. 여기서 먼저 잡는다.
if echo "$SECRET_JSON" | jq -e '.mysql_root_password == "CHANGE_ME"' > /dev/null; then
  echo "FATAL: Secrets Manager 값이 아직 자리표시자입니다." >&2
  echo "  aws secretsmanager put-secret-value --secret-id $SECRET_ID --secret-string '{...}'" >&2
  exit 1
fi

umask 077
TMP_ENV="$(mktemp)"
trap 'rm -f "$TMP_ENV"' EXIT

{
  echo "# 이 파일은 fetch-secrets.sh 가 생성합니다. 직접 수정하지 마세요."
  echo "COMPOSE_PROJECT_NAME=${project}"
  echo "TZ=Asia/Seoul"

  # JSON 키를 대문자 환경변수로 변환한다. (mysql_root_password → MYSQL_ROOT_PASSWORD)
  echo "$SECRET_JSON" | jq -r 'to_entries[] | "\(.key | ascii_upcase)=\(.value)"'

  # 비밀이 아닌 배포 파라미터.
  echo "MYSQL_DATABASE=${mysql_database}"
  echo "MYSQL_USER=${mysql_user}"
  echo "ECR_REGISTRY=${ecr_registry}"
  echo "ECR_REPOSITORY=${ecr_repository}"

  # 이미지 태그는 배포 때 SSM 이 넘겨준다. 그 값을 보존해 재시작 시 같은 버전으로 뜬다.
  if [ -f "$ENV_FILE" ] && grep -q '^IMAGE_TAG=' "$ENV_FILE"; then
    grep '^IMAGE_TAG=' "$ENV_FILE"
  else
    echo "IMAGE_TAG=${default_image_tag}"
  fi
} > "$TMP_ENV"

install -m 600 "$TMP_ENV" "$ENV_FILE"
echo "$ENV_FILE 생성 완료 ($(grep -c '=' "$ENV_FILE") 개 항목)"
