#!/bin/sh
#
# develop·main 을 rebase 로 당겨오는 것을 막는다.
#
#   git pull --rebase          차단
#   pull.rebase=true 설정       차단
#   git pull (merge)           통과
#   git rebase -i HEAD~3       통과
#
# 왜 막나 — develop 을 rebase 로 당기면 이미 push 된 커밋의 SHA 가 바뀐다.
# 되돌리려면 force-push 가 필요하고, 여럿이 같은 develop 을 보는 저장소에서
# 이건 팀 전체의 히스토리를 깨뜨린다. 팀은 이미 merge 로 동기화하고 있다.
#
# 왜 pre-rebase 인가 — `git pull --rebase` 는 이 훅을 반드시 거치고,
# exit≠0 이면 HEAD 가 움직이기 전에 중단된다. 되돌릴 것이 남지 않는다.
#
# 왜 전면 차단이 아닌가 — 내 브랜치의 커밋을 `git rebase -i` 로 정리하는 것은
# 공유 히스토리를 건드리지 않는다. 막을 이유가 없다. 판정은 아래 $1 로 한다.
#
# 판정 — git 이 넘기는 첫 인자가 upstream 이다.
#   git pull --rebase          객체 ID(SHA)   (origin/develop 의 커밋)
#   git rebase origin/develop  origin/develop (revspec)
#   git rebase -i HEAD~2       HEAD~2         (revspec)
# 즉 SHA 면 pull --rebase 다. 그 SHA 가 develop·main 의 것인지 본다.
# 현재 서 있는 브랜치는 보지 않는다 — feature 브랜치에서 develop 을
# 당겨오는 경우도 똑같이 히스토리를 깨뜨리기 때문이다.
#
# 우회 — `git rebase --no-verify` 와 `git -c core.hooksPath= rebase ...` 로 뚫린다.
# 다만 `git pull --rebase --no-verify` 는 뚫리지 않는다. pull 은 --no-verify 를
# rebase 로 넘기지 않아 훅이 그대로 돈다. 막으려는 것이 pull 경로이므로
# 실수 방지에는 충분하다. 훅은 강제가 아니라 안전장치다.
# 우회했다는 사실이 로그에 남지 않으므로 PR 에서 사유를 밝힌다.

set -eu

# 인자가 없으면 무엇을 당겨오는지 판단할 수 없다. 통과시킨다.
[ $# -ge 1 ] || exit 0

upstream=$1

# hex 가 아니면 revspec 이다 = 로컬 rebase. 통과시킨다.
case "$upstream" in *[!0-9a-f]* | "") exit 0 ;; esac

# 길이는 저장소의 object format 을 따른다(SHA-1 40자, SHA-256 64자).
# 상수로 박으면 SHA-256 저장소에서 판정이 통째로 빗나가 fail-open 이 된다.
oid_len=$(git rev-parse HEAD 2>/dev/null | wc -c | tr -d ' ') || oid_len=0
oid_len=$((oid_len - 1))
[ "$oid_len" -gt 0 ] || exit 0
[ "${#upstream}" -eq "$oid_len" ] || exit 0

# 원격 이름을 origin 으로 가정하지 않는다. fork 워크플로에서는 upstream 이고,
# 이름을 바꿔 둔 사람도 있다. 원격 추적 브랜치 전부를 훑어 보호 대상을 찾는다.
# 파이프로 while 을 돌리면 서브셸이 되어 안에서 exit 해도 훅이 통과해 버리므로,
# 이름만 뽑아 변수에 담고 판정은 바깥에서 한다.
protected=$(git for-each-ref --format='%(objectname) %(refname:short)' \
	'refs/remotes/*/develop' 'refs/remotes/*/main' 'refs/remotes/*/master' 2>/dev/null \
	| while read -r sha name; do
		[ "$sha" = "$upstream" ] && { printf '%s' "$name"; break; }
	done) || protected=''

if [ -n "$protected" ]; then
	cat >&2 <<EOF

  $protected 을 rebase 로 당길 수 없다.

  rebase 로 당기면 이미 push 된 커밋의 SHA 가 바뀐다. 되돌리려면
  force-push 가 필요하고, 그러면 팀 전체의 히스토리가 깨진다.

  대신 merge 로 당긴다:
    git pull --no-rebase

  pull.rebase 가 켜져 있으면 끈다. 전역 설정도 함께 확인한다:
    git config --get pull.rebase
    git config --global --get pull.rebase
    git config --global --unset pull.rebase

  IntelliJ 를 쓴다면 Settings > Version Control > Git 의
  Update method 를 Merge 로 둔다.

  내 브랜치를 정리하는 rebase(git rebase -i)는 막지 않는다.

EOF
	exit 1
fi

exit 0
